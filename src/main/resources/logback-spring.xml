<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Application configuration -->
    <springProperty
            scope="context"
            name="SERVICE_NAME"
            source="spring.application.name"
            defaultValue="learning-api"/>

    <!-- Stable identity is shared with the Phase 1 request schema. -->
    <springProperty
            scope="context"
            name="SERVICE_VERSION"
            source="app.version"
            defaultValue="unknown"/>
    <springProperty
            scope="context"
            name="DEPLOYMENT_ENVIRONMENT"
            source="app.deployment-environment"
            defaultValue="development"/>

    <property name="LOG_DIR" value="${APP_LOG_DIR:-./logs}"/>
    <property name="APP_NAME" value="${APP_NAME:-learning-api}"/>
    <property name="LOG_LEVEL" value="${LOG_LEVEL:-INFO}"/>

    <!-- Console appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="com.japaneselearning.learning.logging.StructuredJsonEncoder">
            <serviceName>${SERVICE_NAME}</serviceName>
            <serviceVersion>${SERVICE_VERSION}</serviceVersion>
            <environment>${DEPLOYMENT_ENVIRONMENT}</environment>
        </encoder>
    </appender>

    <!-- Rolling file appender -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_DIR}/${APP_NAME}.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/archive/${APP_NAME}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>

            <maxHistory>30</maxHistory>

            <totalSizeCap>2GB</totalSizeCap>

        </rollingPolicy>

        <encoder class="com.japaneselearning.learning.logging.StructuredJsonEncoder">
            <serviceName>${SERVICE_NAME}</serviceName>
            <serviceVersion>${SERVICE_VERSION}</serviceVersion>
            <environment>${DEPLOYMENT_ENVIRONMENT}</environment>
        </encoder>
    </appender>

    <!-- Request completion owns safe diagnostics; suppress framework raw-path warnings. -->
    <logger name="org.springframework.web.servlet.PageNotFound" level="OFF"/>
    <logger name="org.springframework.boot.security.autoconfigure.UserDetailsServiceAutoConfiguration" level="OFF"/>

    <root level="${LOG_LEVEL}">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
