# Learning Service local configuration
# ====================================
# Copy this file to .env and fill every REQUIRED value before starting.
# .env is ignored by Git; keep credentials out of this example.
# Entries follow src/main/resources/application.properties, with Logback-only
# variables listed at its Logging section. This documents the project's runtime
# settings, not every environment override supported by Spring Boot or the JVM.
# Optional settings fall back only when absent, not when assigned an empty value.

# Application identity (spring.application.name; standard Spring Boot override).
# OPTIONAL. This name is also sent as X-Caller-Service.
SPRING_APPLICATION_NAME=learning-api

# Instance identity (app.instance-id).
# OPTIONAL. Defaults to HOSTNAME, then COMPUTERNAME, then a generated UUID.
# Keep commented for automatic identity, or set a unique value per instance.
# Caller identity values must match [A-Za-z0-9][A-Za-z0-9._-]{0,63}.
# APP_INSTANCE_ID=learning-api-local

# Version (app.version).
# OPTIONAL. Defaults to the Maven build version (currently 0.0.1-SNAPSHOT).
# Remove this override to follow build version changes automatically.
APP_VERSION=0.0.1-SNAPSHOT

# HTTP server.
# OPTIONAL. 0.0.0.0 listens on all interfaces; use 127.0.0.1 for local-only access.
SERVER_ADDRESS=0.0.0.0
# OPTIONAL. Change if another local service already uses port 8080.
SERVER_PORT=8080

# Logging (logback-spring.xml).
# OPTIONAL. Relative paths resolve against the process working directory.
APP_LOG_DIR=./logs
# OPTIONAL. Log filename basename; does not change the service identity.
APP_NAME=learning-api
# OPTIONAL. Prefer INFO; broad DEBUG/TRACE can expose framework request details.
LOG_LEVEL=INFO

# JWKS integration HTTP client.
# REQUIRED. Reachable JWKS service origin, e.g. http://localhost:8081.
# Use its actual port; do not point it back at this Learning Service.
JWKS_SERVICE_BASE_URL=http://localhost:8783
# REQUIRED. Public keys endpoint path, e.g. /api/v1/jwks/user.
JWKS_SERVICE_GET_PUBLIC_KEYS=/api/v1/jwks/user

# JWT verification (independent of the integration client).
# REQUIRED. Full JWKS URL, e.g. http://localhost:8081/api/v1/jwks/user.
# Usually base URL + endpoint path above; configure separately for JWT validation.
JWT_JWK_SET_URI=http://localhost:8783/api/v1/jwks/user
# REQUIRED. Exact issuer claim emitted by the token issuer (case-sensitive).
# Obtain it from the issuer configuration; it is not necessarily a URL.
JWT_ISSUER=
# OPTIONAL. Non-negative duration for token timestamp tolerance, e.g. 60s or 1m.
JWT_CLOCK_SKEW=60s

# PostgreSQL (required for a normal application run with JPA enabled).
# Start PostgreSQL and create the database/user first. No embedded DB is bundled.
# REQUIRED. JDBC URL, e.g. jdbc:postgresql://localhost:5432/learning.
SPRING_DATASOURCE_URL=
# REQUIRED. PostgreSQL login with access to the selected database.
SPRING_DATASOURCE_USERNAME=
# REQUIRED. Password for that login; no sample secret or default is supplied.
SPRING_DATASOURCE_PASSWORD=

# Authenticated User HTTP client (standalone host URLs).
USER_SERVICE_BASE_URL=http://localhost:8781
USER_SERVICE_GET_USER=/internal/users
USER_SERVICE_CONNECT_TIMEOUT=3s
USER_SERVICE_READ_TIMEOUT=5s
USER_SERVICE_INTERNAL_JWT_ENABLED=true
LEARNING_INTERNAL_JWT_ENABLED=true
LEARNING_INTERNAL_JWT_ISSUER=learning-service
LEARNING_INTERNAL_JWT_AUDIENCE=user-service
LEARNING_INTERNAL_JWT_TTL=60s
APP_SECURITY_SIGNING_KEYS_0_KID=learning-rsa-v1
APP_SECURITY_SIGNING_KEYS_0_PRIVATEKEYPATH=../data/keys/learning/learningservice-private-v1.pem
APP_SECURITY_SIGNING_KEYS_0_ACTIVE=true
